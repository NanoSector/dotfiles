eval ({{ .homebrew_path }}/brew shellenv)

# $PATH manipulations - always use -g or -P to keep this list authorative! asdfvm should stay the last entry
fish_add_path -g ~/.local/bin
fish_add_path -g (test -n "$ASDF_DATA_DIR"; and echo $ASDF_DATA_DIR; or echo $HOME/.asdf)/shims

# Fixes config file locations for e.g. lazygit and ghostty
set -gx XDG_CONFIG_HOME "$HOME/.config"

# EDITOR configuration
set -gx EDITOR $(which fresh)
set -gx MICRO_TRUECOLOR 1

{{- if ne .chezmoi.os "darwin" }}
# Use KDE Wallet for pinentry
set -gx PINENTRY_KDE_USE_WALLET 1
{{- end }}

# Fish configuration
# Disable Fish greeting
set fish_greeting
fish_config theme choose catppuccin-mocha

bind alt-backspace backward-kill-word

# Aliases
alias cd="z"
alias l="eza --long --header --git"
alias tree="eza -T --long"

# Tool replacements
alias ls="l"
alias nano="fresh"
alias cat="bat"
alias df="duf"
alias cm="chezmoi"
alias lg="lazygit"
alias tg="terragrunt"
set -gx MANPAGER "bat -plman"

# Initialise utilities
zoxide init fish | source
starship init fish | source
fzf --fish | source
direnv hook fish | source

# Initialise FZF w/ Catppuccin Mocha
set -gx FZF_DEFAULT_OPTS "\
--color=bg+:#313244,bg:#1E1E2E,spinner:#F5E0DC,hl:#F38BA8 \
--color=fg:#CDD6F4,header:#F38BA8,info:#CBA6F7,pointer:#F5E0DC \
--color=marker:#B4BEFE,fg+:#CDD6F4,prompt:#CBA6F7,hl+:#F38BA8 \
--color=selected-bg:#45475A \
--color=border:#6C7086,label:#CDD6F4"
set -gx FZF_CTRL_T_OPTS "\
--style full \
--walker-skip .git,node_modules,target,vendor \
--preview 'bat -n --color=always {}' \
--bind 'ctrl-/:change-preview-window(down|hidden|)'"
